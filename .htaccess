RewriteEngine On

# Keep the homepage canonical as the root URL.
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s#]) [NC]
RewriteRule ^index\.html$ / [R=301,L]

# Redirect public HTML-file URLs to clean, extensionless URLs.
# The THE_REQUEST check prevents an internal rewrite from looping back here.
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html(?:[?\s#]) [NC]
RewriteRule ^(.+)\.html$ /$1 [R=301,L,NE]

# Serve extensionless URLs from the matching HTML file when it exists.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
